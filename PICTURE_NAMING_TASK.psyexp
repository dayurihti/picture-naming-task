        <Param val="breakDuration = 30;&amp;#10;breakClock.reset();&amp;#10;countdown = breakDuration;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="breakDuration = 31&amp;#10;countdown = breakDuration" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="remaining = int(breakDuration - t)&amp;#10;countdown = max(remaining, 0)&amp;#10;&amp;#10;text_nonswitching_block.setText(&amp;#10;    &quot;Selamat, Anda telah menyelesaikan blok latihan!\n\n&quot;&amp;#10;    &quot;Setelah jeda istirahat, Anda akan mengerjakan blok non-switching.\n&quot;&amp;#10;    &quot;Jangan lupa mengikuti kode bendera Indonesia dan Inggris.\n\n&quot;&amp;#10;    f&quot;Jeda istirahat dalam {countdown} detik&quot;&amp;#10;)&amp;#10;&amp;#10;if t &gt;= breakDuration:&amp;#10;    continueRoutine = False&amp;#10;   " valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="remaining = Number.parseInt((breakDuration - breakClock.getTime()));&amp;#10;countdown = Math.max(remaining, 0);&amp;#10;if ((breakClock.getTime() &gt;= breakDuration)) {&amp;#10;    continueRoutine = false;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code" valType="code" updates="None" name="name"/>
