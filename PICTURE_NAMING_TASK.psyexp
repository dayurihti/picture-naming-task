        <Param val="remaining = int(breakDuration - t)&amp;#10;countdown = max(remaining, 0)&amp;#10;&amp;#10;text_switching_block.setText(&amp;#10;    &quot;Selamat, Anda telah menyelesaikan blok non-switching!\n\n&quot;&amp;#10;    &quot;Setelah jeda istirahat, Anda akan mengerjakan blok switching.\n&quot;&amp;#10;    &quot;Ikuti kode bendera Indonesia dan Inggris seperti sebelumnya.\n\n&quot;&amp;#10;    f&quot;Jeda istirahat dalam {countdown} detik&quot;&amp;#10;)&amp;#10;&amp;#10;if t &gt;= breakDuration:&amp;#10;    continueRoutine = False" valType="extendedCode" updates="constant" name="Each Frame"/>
